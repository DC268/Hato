# ========================================================
# VARIABLES DE ENTORNO PARA HATO BACKEND (Supabase & Render)
# ========================================================

# Puerto HTTP en Render (Render inyecta PORT automáticamente)
PORT=8080

# 1. Base de Datos en Supabase (PostgreSQL)
# En el Dashboard de Supabase -> Project Settings -> Database -> Connection string (JDBC/URI):
# Modo directo (Puerto 5432) o Connection Pooling (Puerto 6543):
HATO_DB_URL=jdbc:postgresql://db.xxxxxxxxxxxx.supabase.co:5432/postgres?sslmode=require
HATO_DB_USER=postgres
HATO_DB_PASSWORD=TuContrasenaSupabase2026!

# 2. Seguridad y Firma de Tokens JWT (Cadena segura de mínimo 256 bits)
HATO_JWT_SECRET=4c9b3d2f8e1a7c5b6a9e8d7c6b5a4f3e2d1c0b9a8f7e6d5c4b3a2f1e0d9c8b7a
HATO_JWT_EXPIRATION_MINUTES=1440

# 3. Clave Secreta para Ingesta de Posiciones desde Traccar o Antenas LoRa
HATO_INGEST_KEY=hato-secret-ingest-key-2026

# 4. Google Sign-In (Web Client ID de Google Cloud Console)
GOOGLE_CLIENT_ID=982736451234-sampleclientidhato.apps.googleusercontent.com

# 5. Puerto TCP para recepción directa de collares GPS (opcional si se usa Traccar)
HATO_GPS_TCP_PORT=5023
HATO_GPS_TCP_ENABLED=true
